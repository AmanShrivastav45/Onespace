{
  "name": "onespace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json .prettierrc.json",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@dayflow/core": "^3.7.5",
    "@dayflow/plugin-drag": "^1.6.2",
    "@dayflow/plugin-keyboard-shortcuts": "^1.6.1",
    "@dayflow/plugin-sidebar": "^1.6.5",
    "@dayflow/react": "^3.7.5",
    "@fontsource-variable/geist": "^5.3.0",
    "axios": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
